// public/scripts.js
const API_ENDPOINT = 'http://localhost:3000/monthly-reports';

// --- DATE LOGIC (FIXED: Uses 1-based index for select/DB) ---

/**
 * Calculates the month and year for the last complete month.
 * Returns the month as a 1-based index (1-12) and the correct year.
 */
const getDefaultMonthAndYear = () => {
    const today = new Date();
    // JavaScript getMonth() is 0-indexed (Jan=0).
    let previousMonthJs = today.getMonth(); 
    let previousYear = today.getFullYear();

    // If today is January (0), the previous month is December (11) of the last year
    if (previousMonthJs === 0) {
        previousMonthJs = 11; 
        previousYear = previousYear - 1;
    } else {
        // Otherwise, it's just the previous month
        previousMonthJs = previousMonthJs - 1;
    }

    // CRITICAL: Return the 1-based month index (used by the database and HTML options)
    const previousMonthDb = previousMonthJs + 1; 
    
    return {
        month: String(previousMonthDb), // Use 1-indexed string for setting the select value
        year: String(previousYear)
    };
};

const defaultDate = getDefaultMonthAndYear();
const DEFAULT_MONTH = defaultDate.month;
const DEFAULT_YEAR = defaultDate.year;

let availableNames = [];

// UTILITY FUNCTIONS

// Converts the table data array into a CSV string.
function convertToCsv(data) {
    if (data.length === 0) return '';
    
    // Check the state of the new checkbox
    const includeGroupsCheckbox = document.getElementById('include-group-averages');
    const includeGroups = includeGroupsCheckbox ? includeGroupsCheckbox.checked : true; // Default to true if checkbox is missing
    
    let filteredData = data;
    
    // Filter out group monitors unless the user checked the box
    if (!includeGroups) {
        filteredData = data.filter(item => item.type !== 'group');
    }
    
    if (filteredData.length === 0) return ''; // Recheck after filtering
    
    // Use the keys of the first object for the header
    const header = Object.keys(filteredData[0]).join(','); 
    
    const rows = filteredData.map(row => 
        Object.values(row).map(value => 
            // Sanitize values for CSV
            `"${String(value).replace(/"/g, '""')}"`
        ).join(',')
    );
    
    return [header, ...rows].join('\n');
}

// Triggers the download of the CSV file.
function downloadCsv(csvString) {
    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement("a");
    const url = URL.createObjectURL(blob);
    
    link.setAttribute("href", url);
    link.setAttribute("download", `uptime_report_${document.getElementById('month-select').value}_${document.getElementById('year-select').value}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Populates the Month and Year dropdowns.
function populateDateFilters() {
    const monthSelect = document.getElementById('month-select');
    const yearSelect = document.getElementById('year-select');

    const months = [
        { val: '1', name: 'January' }, { val: '2', name: 'February' },
        { val: '3', name: 'March' }, { val: '4', name: 'April' },
        { val: '5', name: 'May' }, { val: '6', name: 'June' },
        { val: '7', name: 'July' }, { val: '8', name: 'August' },
        { val: '9', name: 'September' }, { val: '10', name: 'October' },
        { val: '11', name: 'November' }, { val: '12', name: 'December' }
    ];

    // Populate Months
    months.forEach(month => {
        const option = document.createElement('option');
        option.value = month.val;
        option.textContent = month.name;
        monthSelect.appendChild(option);
    });

    // Populate Years (e.g., last 5 years)
    const currentYear = new Date().getFullYear();
    for (let i = 0; i < 5; i++) {
        const year = currentYear - i;
        const option = document.createElement('option');
        option.value = String(year);
        option.textContent = String(year);
        yearSelect.appendChild(option);
    }

    // Set default values (uses the 1-indexed DEFAULT_MONTH)
    monthSelect.value = DEFAULT_MONTH;
    yearSelect.value = DEFAULT_YEAR;
}

function renderTable(data) {
    const container = document.getElementById('report-table-container');
    if (!container) return;
    
    // Clear the container before rendering new data
    container.innerHTML = ''; 

    if (data.length === 0) {
        container.innerHTML = '<p>No data found for the selected filters.</p>';
        return;
    }

    // --- 1. Group Data (Logic remains the same) ---
    const groups = new Map();
    const unGroupedMonitors = [];

    data.forEach(item => {
        const mId = String(item.m_id); 
        const parentId = item.parent ? String(item.parent) : null;
        
        if (parentId && !groups.has(parentId)) {
            groups.set(parentId, { parentData: null, children: [] });
        }
        if (!groups.has(mId)) {
            groups.set(mId, { parentData: null, children: [] });
        }
        
        if (parentId) {
            groups.get(parentId).children.push(item);
        } else if (item.type === 'group' && !parentId) {
            groups.get(mId).parentData = item;
        } else if (!parentId && item.type !== 'group') {
            unGroupedMonitors.push(item);
        }
    });
    
    const parentGroups = Array.from(groups.values())
        .filter(group => group.parentData)
        .sort((a, b) => a.parentData.name.localeCompare(b.parentData.name));
        
    // --- 2. Render Groups into Separate Tables ---
    
    // RENDER: Parent Groups
    parentGroups.forEach(group => {
        const parent = group.parentData;
        const children = group.children.sort((a, b) => a.name.localeCompare(b.name));
        // Skip rendering the table if there are no children (only the parent was returned)
        if (children.length === 0) return; 

        // A. Render Group Header (H4)
        const h4 = document.createElement('h4');
        const groupUptime = parent.uptime ? parent.uptime.toFixed(2) + '%' : 'N/A';
        h4.innerHTML = `${parent.name} | Average Uptime: ${groupUptime}`;
        container.appendChild(h4);

        // B. Render Table Structure
        const table = document.createElement('table');
        table.id = `report-table-${parent.m_id}`; // Give each table a unique ID
        table.setAttribute('border', '1');

        
        // Create Table Header (Header is consistent for all tables)
        table.innerHTML = `
            <thead>
                <tr>
                    <th>Monitor ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Parent</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Response Time (ms)</th>
                    <th>Uptime (%)</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        `;
        container.appendChild(table);

        const tableBody = table.querySelector('tbody');

        // C. Render Children Rows
        children.forEach(item => {
            const row = tableBody.insertRow();
            // Children rows are just standard data rows now
            row.insertCell().textContent = item.m_id;
            row.insertCell().textContent = item.name;
            row.insertCell().textContent = item.type || 'N/A';
            row.insertCell().textContent = item.parent || 'N/A';
            row.insertCell().textContent = item.pretty_month.split(' ')[0];
            row.insertCell().textContent = item.year;
            row.insertCell().textContent = item.response_time ? item.response_time.toFixed(3) : 'N/A';
            row.insertCell().textContent = item.uptime ? item.uptime.toFixed(2) : 'N/A';
        });
        
        container.appendChild(document.createElement('br')); // Separator between tables
    });

    // RENDER: Un-Grouped Monitors (Optional, but good practice)
    if (unGroupedMonitors.length > 0) {
        const h4 = document.createElement('h4');
        h4.textContent = `Ungrouped Monitors`;
        container.appendChild(h4);

        const table = document.createElement('table');
        table.setAttribute('border', '1');
        
        // ... Render table header and rows ... (similar logic as above)
        // Omitted for brevity, but follows the same pattern as group tables.
    }
}

// Sets up the event listener for a Parent Group checkbox.
function setupGroupToggle(parentCheckbox, childMonitorIds) {
    
    // 1. Parent Checkbox Listener (Parent -> Children)
    parentCheckbox.addEventListener('change', (e) => {
        const isChecked = e.target.checked;
        
        // Standard behavior: Toggle all children
        childMonitorIds.forEach(id => {
            const childCheckbox = document.querySelector(`input[value="${id}"]`);
            if (childCheckbox) {
                childCheckbox.checked = isChecked;
            }
        });
        
        // Crucial: After toggling children, trigger a data fetch
        fetchAndRenderData();
    });
    
    // 2. Child Checkbox Listeners (Children -> Parent) (Unchanged)
    childMonitorIds.forEach(id => {
        const childCheckbox = document.querySelector(`input[value="${id}"]`);
        if (childCheckbox) {
            childCheckbox.addEventListener('change', () => {
                const allChecked = childMonitorIds.every(childId => {
                    const cb = document.querySelector(`input[value="${childId}"]`);
                    return cb && cb.checked;
                });
                
                // If not all are checked, uncheck the parent (standard logic)
                parentCheckbox.checked = allChecked;
                
                // Crucial: After changing child state, trigger a data fetch
                fetchAndRenderData();
            });
        }
    });
}


// Populates the Name filters with a Parent/Child hierarchy.
function populateNameFilters(allData) {
    const nameFiltersDiv = document.getElementById('name-filters');
    if (!nameFiltersDiv) return;
    nameFiltersDiv.innerHTML = ''; 

    // 1. Group Data into Parent/Child Structure
    const groups = new Map();
    const monitors = []; 

    // Initialize all groups and assign children
    allData.forEach(item => {
        const mId = String(item.m_id); 
        const parentId = item.parent ? String(item.parent) : null;
        
        // Ensure the parent group structure exists for the current monitor's parent ID
        if (parentId && !groups.has(parentId)) {
            groups.set(parentId, { parentData: null, children: [] });
        }
        
        // Ensure the current monitor's ID (if it's a parent) has a structure
        if (!groups.has(mId)) {
            groups.set(mId, { parentData: null, children: [] });
        }

        if (parentId) {
            // This is a child monitor
            groups.get(parentId).children.push(item);
        }
        
        if (item.type === 'group' && !parentId) {
            // This is a parent monitor (Group)
            groups.get(mId).parentData = item;
        } else if (!parentId && item.type !== 'group') {
            // This is an un-grouped, single monitor
            monitors.push(item);
        }
    });

    // 2. Filter and sort only complete parent groups
    const parentGroups = Array.from(groups.values())
        .filter(group => group.parentData) // Must have parent metadata
        .sort((a, b) => a.parentData.name.localeCompare(b.parentData.name));
        
    // 3. Render HTML and Setup Listeners
    
    parentGroups.forEach(group => {
        const parent = group.parentData;
        
        // Create the main <details> container for the group
        const details = document.createElement('details');
        details.className = 'monitor-group';
        
        // Create <summary> with the Parent Checkbox
        const summary = document.createElement('summary');
        
        const parentCheckbox = document.createElement('input');
        parentCheckbox.type = 'checkbox';
        parentCheckbox.id = `group-${parent.m_id}`;
        parentCheckbox.value = parent.m_id; // Value is parent's m_id
        parentCheckbox.checked = true;
        
        const parentLabel = document.createElement('label');
        parentLabel.setAttribute('for', `group-${parent.m_id}`);
        parentLabel.textContent = `${parent.name} (Group ID: ${parent.m_id})`;

        summary.appendChild(parentCheckbox);
        summary.appendChild(parentLabel);
        details.appendChild(summary);
        
        // --- Render Children Monitors ---
        const childrenDiv = document.createElement('div');
        childrenDiv.className = 'group-children';
        
        const childMonitorIds = [];
        
        group.children
            .sort((a, b) => a.name.localeCompare(b.name))
            .forEach((monitor, index) => {
                const container = document.createElement('div');
                const checkbox = document.createElement('input');
                const label = document.createElement('label');
                
                checkbox.type = 'checkbox';
                checkbox.id = `monitor-${monitor.m_id}`;
                checkbox.value = monitor.m_id; // Value is child's m_id
                checkbox.checked = true;
                
                label.setAttribute('for', `monitor-${monitor.m_id}`);
                label.textContent = `${monitor.name} (ID: ${monitor.m_id})`;
                
                container.appendChild(checkbox);
                container.appendChild(label);
                childrenDiv.appendChild(container);
                
                childMonitorIds.push(monitor.m_id);
            });
            
        details.appendChild(childrenDiv);
        nameFiltersDiv.appendChild(details);

        // Setup the toggling functionality for this group
        setupGroupToggle(parentCheckbox, childMonitorIds);
    });
    
    // --- Render Un-grouped/Single Monitors ---
    monitors
        .sort((a, b) => a.name.localeCompare(b.name))
        .forEach(monitor => {
            const container = document.createElement('div');
            const checkbox = document.createElement('input');
            const label = document.createElement('label');
            
            checkbox.type = 'checkbox';
            checkbox.id = `monitor-${monitor.m_id}`;
            checkbox.value = monitor.m_id; 
            checkbox.checked = true;
            
            label.setAttribute('for', `monitor-${monitor.m_id}`);
            label.textContent = `${monitor.name} (ID: ${monitor.m_id})`;
            
            container.appendChild(checkbox);
            container.appendChild(label);
            nameFiltersDiv.appendChild(container);
        });
}

// Fetches data based on current filters and renders the table (using GET).
async function fetchAndRenderData() {
    const selectedMonth = document.getElementById('month-select').value;
    const selectedYear = document.getElementById('year-select').value;
    
    // Get the base set of IDs: all currently CHECKED checkboxes (parents AND children)
    const checkedCheckboxes = document.querySelectorAll('#name-filters input[type="checkbox"]:checked');
    const baseIds = Array.from(checkedCheckboxes).map(cb => cb.value); 
    
    // Use a Set to store IDs, ensuring only unique IDs are sent to the API
    const finalIdsToFetch = new Set(baseIds);
    
    // --- CORE BUG FIX ---
    // Iterate over the base list and ensure any child's parent ID is also included.
    
    // Assuming 'allMonitorData' is the global array of all monitor objects fetched during init.
    if (typeof allMonitorData !== 'undefined') {
        const monitorMap = new Map(allMonitorData.map(m => [String(m.m_id), m]));

        baseIds.forEach(id => {
            const monitor = monitorMap.get(id);
            
            // If this is a child monitor AND it has a parent...
            if (monitor && monitor.parent) {
                // Add the parent's ID (the group monitor) to the final fetch list
                finalIdsToFetch.add(String(monitor.parent));
            }
        });
    }

    // Convert the unique IDs back to a comma-separated string
    const selectedMonitorIds = Array.from(finalIdsToFetch).join(',');
    
    // Construct the URL with filters
    let url = `${API_ENDPOINT}?month=${selectedMonth}&year=${selectedYear}`;
    
    // Only add monitor_ids to the URL if the string is NOT empty.
    if (selectedMonitorIds) {
        url += `&monitor_ids=${selectedMonitorIds}`;
    }

    const reportTableContainer = document.getElementById('report-table-container'); 
    const resultCountSpan = document.getElementById('result-count'); 
    const downloadButton = document.getElementById('download-csv');

    // Update the Safety check to use the new container
    if (!reportTableContainer || !resultCountSpan || !downloadButton) {
         console.error("CRITICAL ERROR: Failed to find essential DOM elements. Check index.html IDs for typos.");
         return; 
    }
    
    console.log("Fetching URL:", url);

    resultCountSpan.textContent = '...';
    downloadButton.disabled = true;

    reportTableContainer.innerHTML = '<p>Loading...</p>';

try {
        const response = await fetch(url);
        const result = await response.json();

        if (result.status === 'success' && result.data) {
            console.log('2 Rows Fetched: ' + result.count);
            renderTable(result.data); // <-- This is now running!
            
            resultCountSpan.textContent = result.data.length;

            downloadButton.onclick = () => {
                downloadCsv(convertToCsv(result.data));
            };
            downloadButton.disabled = result.data.length === 0;

        } else {
            // FIX 1: Use reportTableContainer for error message
            reportTableContainer.innerHTML = `<p>Error fetching data: ${result.error || 'Unknown error'}</p>`;
            resultCountSpan.textContent = '0';
        }

    } catch (error) {
        // FIX 2: Use reportTableContainer for network error message
        reportTableContainer.innerHTML = '<p>Network Error: Could not connect to the API.</p>';
        resultCountSpan.textContent = '0';
        console.error("Fetch error:", error);
    }
}


// INITIALIZATION
async function init() {
    populateDateFilters();

    // 1. Initial fetch to get ALL unique monitor names/IDs for the filter list.
    try {
        const url = `${API_ENDPOINT}?year=${DEFAULT_YEAR}&monitor_ids=`;
        
        const allNamesResponse = await fetch(url);
        const allNamesResult = await allNamesResponse.json();

        if (allNamesResult.status === 'success' && allNamesResult.data) {
            console.log('1 Rows Fetched for Filters: ' + allNamesResult.count);
            populateNameFilters(allNamesResult.data);
        }
    } catch (e) {
        console.warn("Could not populate name filters automatically. Check API connection.", e);
    }

    // 2. Set up event listeners
    document.getElementById('apply-filters').addEventListener('click', fetchAndRenderData);
    
    // 3. Load the default view 
    fetchAndRenderData(); 
}

// Start initialization when the DOM is ready
document.addEventListener('DOMContentLoaded', init);